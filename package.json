{
  "name": "memora",
  "version": "1.0.0",
  "description": "Memoora - Modern Note-Taking Application built with Next.js App Router, React 19, TypeScript, and Prisma",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx node_modules/mocha/bin/mocha.js \"tests/**/*.test.ts\"",
    "test:backend": "tsx node_modules/mocha/bin/mocha.js \"tests/backend/**/*.test.ts\"",
    "test:frontend": "tsx node_modules/mocha/bin/mocha.js \"tests/frontend/**/*.test.ts\"",
    "lint": "oxlint app components lib services context types",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "cookie": "^1.0.2",
    "dompurify": "^3.4.17",
    "jsonwebtoken": "^9.0.3",
    "next": "^15.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^4.3.20",
    "@types/cookie": "^0.6.0",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "chai": "^5.2.0",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "mocha": "^11.1.0",
    "oxlint": "^1.92.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0"
  }
}
